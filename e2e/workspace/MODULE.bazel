bazel_dep(name = "rules_zig", version = "0.6.1", dev_dependency = True)
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", dev_dependency = True)
bazel_dep(name = "bazel_features", version = "1.47.1", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.9.0", dev_dependency = True)
bazel_dep(name = "platforms", version = "1.1.0", dev_dependency = True)
bazel_dep(name = "rules_cc", version = "0.2.18", dev_dependency = True)

local_path_override(
    module_name = "rules_zig",
    path = "../..",
)

zig = use_extension(
    "@rules_zig//zig:extensions.bzl",
    "zig",
    dev_dependency = True,
)
zig.toolchain(zig_version = "0.17.0")
zig.toolchain(zig_version = "0.16.0")
use_repo(zig, "zig_toolchains")

zig_packages = use_extension(
    "@rules_zig//zig:packages.bzl",
    "zig_packages",
    dev_dependency = True,
)
zig_packages.from_file(build_zig_zon = "//zig-package-import/app:build.zig.zon")
zig_packages.patch(
    name = "libxev",
    patches = ["//zig-package-import/app:libxev_build_zig.patch"],
)
zig_packages.patch(
    name = "httpz",
    patches = ["//zig-package-import/app:httpz_build_zig.patch"],
)
zig_packages.patch(
    name = "metrics",
    patches = ["//zig-package-import/app:metrics_build_zig.patch"],
)
zig_packages.patch(
    name = "sqlite",
    patches = ["//zig-package-import/app:sqlite.patch"],
)
zig_packages.patch(
    name = "zlua",
    patches = ["//zig-package-import/app:zlua.patch"],
)
zig_packages.patch(
    name = "zap",
    patches = [
        "//zig-package-import/app:zap_build_zig.patch",
        "//zig-package-import/app:zap_facilio_build_zig.patch",
        "//zig-package-import/app:zap_fiobj_numbers.patch",
    ],
)
use_repo(zig_packages, "zig_deps")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "arocc",
    build_file = "//third_party/arocc:arocc.bazel",
    sha256 = "423d54bb68d08b457459e9467832ddf8049611563ebb0fef9867e13d94513d98",
    strip_prefix = "arocc-d0c8c4d9c55daa7ef6e40cf0f630a5b5e900989b",
    url = "https://github.com/Vexu/arocc/archive/d0c8c4d9c55daa7ef6e40cf0f630a5b5e900989b.tar.gz",
)

http_archive(
    name = "translate-c",
    build_file = "//third_party/translate-c:translate-c.bazel",
    sha256 = "948dbb0efe888bf436f6fbe00c5099d42975f916e7fe92838c1a0c29869fd44d",
    strip_prefix = "translate-c-0da7a16c3235b935b82421646076e0657cda21f6",
    # Upstream: https://codeberg.org/ziglang/translate-c/commit/0da7a16c3235b935b82421646076e0657cda21f6
    url = "https://github.com/aherrmann/translate-c/archive/0da7a16c3235b935b82421646076e0657cda21f6.tar.gz",
)

register_toolchains("//third_party/translate-c:toolchain")

bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4", dev_dependency = True)

buildbuddy = use_extension(
    "@toolchains_buildbuddy//:extensions.bzl",
    "buildbuddy",
    dev_dependency = True,
)
use_repo(buildbuddy, "buildbuddy_toolchain")

bazel_dep(name = "runfiles_library_dependency", dev_dependency = True)
local_path_override(
    module_name = "runfiles_library_dependency",
    path = "runfiles-library/dependency",
)

local_path_override(
    module_name = "runfiles_library_transitive_dependency",
    path = "runfiles-library/dependency/transitive-dependency",
)

bazel_dep(
    name = "rules_foreign_cc",
    version = "0.15.1",
    dev_dependency = True,
)
