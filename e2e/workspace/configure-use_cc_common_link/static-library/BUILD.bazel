load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_configure", "zig_configure_binary", "zig_configure_test", "zig_shared_library", "zig_static_library", "zig_test")

cc_library(
    name = "add",
    srcs = ["add.c"],
    linkstatic = True,
)

zig_binary(
    name = "binary",
    main = "main.zig",
    tags = ["manual"],
    deps = [
        ":add",
        "@rules_zig//zig/lib:libc",
    ],
)

zig_configure_binary(
    name = "binary_linked_with_cc_common_link",
    actual = ":binary",
    target_compatible_with = select({
        # fails on macOS, see //cc-dependencies/static-library:add-test
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    use_cc_common_link = 1,
)

zig_static_library(
    name = "static-library",
    main = "static-library.zig",
    tags = ["manual"],
    deps = [":add"],
)

zig_configure(
    name = "static_library_with_cc_link_setting",
    actual = ":static-library",
    use_cc_common_link = 1,
)

zig_configure(
    name = "static_library_without_cc_link_setting",
    actual = ":static-library",
    use_cc_common_link = 0,
)

cc_test(
    name = "static-library-consumer",
    size = "small",
    srcs = ["static-library-consumer.c"],
    deps = [":static_library_with_cc_link_setting"],
)

zig_shared_library(
    name = "shared-library",
    main = "main.zig",
    tags = ["manual"],
    deps = [
        ":add",
        "@rules_zig//zig/lib:libc",
    ],
)

zig_configure(
    name = "shared_library_linked_with_cc_common_link",
    actual = ":shared-library",
    target_compatible_with = select({
        # fails on macOS, see //cc-dependencies/static-library:add-test
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    use_cc_common_link = 1,
)

zig_test(
    name = "test",
    size = "small",
    main = "main.zig",
    tags = ["manual"],
    deps = [
        ":add",
        "@rules_zig//zig/lib:libc",
    ],
)

zig_configure_test(
    name = "test_linked_with_cc_common_link",
    size = "small",
    actual = ":test",
    target_compatible_with = select({
        # fails on macOS, see //cc-dependencies/static-library:add-test
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    use_cc_common_link = 1,
)

genrule(
    name = "output",
    outs = ["output.actual"],
    cmd = "$(execpath :binary_linked_with_cc_common_link) > $(OUTS)",
    tools = [":binary_linked_with_cc_common_link"],
)

diff_test(
    name = "output_test",
    size = "small",
    file1 = ":output.expected",
    file2 = ":output.actual",
)

genrule(
    name = "static-library-symbol",
    srcs = [
        ":static_library_with_cc_link_setting",
        ":static_library_without_cc_link_setting",
    ],
    outs = ["library-symbol.txt"],
    # Both archives leave `add` undefined for the consumer to resolve.
    cmd = """
        set -e
        for archive in $(SRCS); do
            undefined=$$($(NM) --undefined-only "$$archive")
            printf '%s\\n' "$$undefined" | grep -E '(^|[[:space:]])_?add$$'
            defined=$$($(NM) --defined-only "$$archive")
            if printf '%s\\n' "$$defined" | grep -E '(^|[[:space:]])_?add$$'; then
                echo "Unexpected definition of add in $$archive" >&2
                exit 1
            fi
        done > "$@"
    """,
    toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
)

build_test(
    name = "build",
    size = "small",
    targets = [
        ":binary_linked_with_cc_common_link",
        ":shared_library_linked_with_cc_common_link",
        ":static-library-symbol",
        ":test_linked_with_cc_common_link",
    ],
)

_FREESTANDING_COMPATIBILITY = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
]

zig_binary(
    name = "freestanding",
    compiler_runtime = "exclude",
    linkopts = [
        "-nostdlib",
        "-static",
        "-Wl,-e,_start",
        "-Wl,-u,_start",
    ],
    main = "freestanding.zig",
    tags = ["manual"],
    target_compatible_with = _FREESTANDING_COMPATIBILITY,
    zigopts = ["-fllvm"],
)

zig_configure_binary(
    name = "freestanding_linked_with_cc_common_link",
    actual = ":freestanding",
    mode = "release_small",
    target_compatible_with = _FREESTANDING_COMPATIBILITY,
    use_cc_common_link = 1,
)

build_test(
    name = "freestanding_build",
    size = "small",
    target_compatible_with = _FREESTANDING_COMPATIBILITY,
    targets = [":freestanding_linked_with_cc_common_link"],
)
