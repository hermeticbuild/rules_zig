load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_zig//zig:defs.bzl", "zig_binary")
load("@zig_deps//:defs.bzl", "zig_deps", "zig_package_artifact")

# The imported packages require Zig 0.17+.
_REQUIRES_ZIG_0_17 = select({
    "@zig_toolchains//:0.16.0": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# The binary imports the fetched Zig packages resolved through `zig_deps()`;
# `src/main.zig` documents what each one exercises.
zig_binary(
    name = "app",
    main = "src/main.zig",
    target_compatible_with = _REQUIRES_ZIG_0_17,
    deps = zig_deps(),
)

genrule(
    name = "output",
    outs = ["output.actual"],
    cmd = "$(execpath :app) > $(OUTS)",
    tools = [":app"],
)

# `libxev`'s backend, and so the output, depends on the target platform.
diff_test(
    name = "output_test",
    size = "small",
    file1 = select({
        "@platforms//os:macos": ":output.macos.expected",
        "//conditions:default": ":output.linux.expected",
    }),
    file2 = ":output.actual",
)

build_test(
    name = "build_test",
    size = "small",
    targets = [":app"],
)

# `hiae` installs a Zig-root static library; the importer emits it as a
# `zig_static_library` artifact target. Building it proves the importer renders
# a real package's installed artifact into a compilable target.
build_test(
    name = "hiae_artifact_build_test",
    size = "small",
    target_compatible_with = _REQUIRES_ZIG_0_17,
    targets = [zig_package_artifact("hiae")],
)
