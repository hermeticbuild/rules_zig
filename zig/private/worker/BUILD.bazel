load("//zig:defs.bzl", "zig_binary", "zig_test")

filegroup(
    name = "sources",
    srcs = ["worker.zig"],
    visibility = ["//zig/private:__pkg__"],
)

zig_binary(
    name = "worker",
    main = "worker.zig",
    tags = ["manual"],
    visibility = ["//zig:__subpackages__"],
)

zig_test(
    name = "worker_test",
    size = "small",
    main = "worker.zig",
    visibility = ["//zig/tests:__pkg__"],
)

filegroup(
    name = "all_files",
    srcs = [
        "BUILD.bazel",
        "DESIGN.md",
        "PLAN.md",
        "probe.py",
        "worker.zig",
    ],
    visibility = ["//zig/private:__pkg__"],
)
