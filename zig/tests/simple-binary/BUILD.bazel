load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_binary")

zig_binary(
    name = "binary",
    main = "main.zig",
    visibility = ["//zig/tests:__pkg__"],
)

zig_binary(
    name = "binary_link_exec_properties",
    exec_properties = {"cpp_link.no-remote-exec": "1"},
    main = "main.zig",
    tags = ["manual"],
    visibility = ["//zig/tests:__pkg__"],
)

cc_library(
    name = "native_link_flags",
    linkopts = [
        "-pthread",
        "-lm",
    ],
    tags = ["manual"],
)

zig_binary(
    name = "binary_native_link_flags",
    main = "main.zig",
    tags = ["manual"],
    visibility = ["//zig/tests:__pkg__"],
    deps = [":native_link_flags"],
)
