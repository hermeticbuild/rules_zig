load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_zig//zig:defs.bzl", "zig_binary")
load("@zig_deps//:defs.bzl", "zig_dep", "zig_package_file")

# The binary resolves its imports through the enclosing manifest's declared
# dependencies. `top` pulls its diamond (`left`/`right`/`bottom`/`base`)
# transitively. The copies of `lib`, declared as `lib`, `libfork` and `lib2`,
# resolve per the manifest, the latter two remapped to their declared names.
libfork = zig_dep("libfork")

lib2 = zig_dep("lib2")

zig_binary(
    name = "binary",
    import_names = {
        libfork: "libfork",
        lib2: "lib2",
    },
    main = "main.zig",
    deps = [
        zig_dep("bottom"),
        zig_dep("leaf"),
        zig_dep("lib"),
        zig_dep("top"),
        libfork,
        lib2,
    ],
)

# The extracted module graph of the multi-module fixture: two registered
# modules plus an anonymous one under a synthesized stable name.
diff_test(
    name = "multi_manifest_test",
    file1 = "multi_manifest.expected.json",
    file2 = zig_package_file("multi", "module_manifest.json"),
)
