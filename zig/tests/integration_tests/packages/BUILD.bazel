load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_binary")
load("@zig_deps//:defs.bzl", "zig_deps", "zig_import_names", "zig_package_file")

# The binary wires every dependency the manifest declares. `top` pulls its
# diamond (`left`/`right`/`bottom`/`base`) transitively; the copies of `lib`
# (declared `lib`, `libfork` and `lib2`) all expose a module named `lib`, so
# `zig_import_names` remaps the latter two to their declared names.
zig_binary(
    name = "binary",
    import_names = zig_import_names(),
    main = "main.zig",
    # `@child_module//:child_lib` is imported as `child`; its own dependencies
    # resolve through the `child_module`'s separate `from_file` manifest.
    deps = zig_deps() + ["@child_module//:child_lib"],
)

# The extracted module graph of the multi-module fixture: two registered
# modules plus an anonymous one under a synthesized stable name.
diff_test(
    name = "multi_manifest_test",
    file1 = "multi_manifest.expected.json",
    file2 = zig_package_file("multi", "module_manifest.json"),
)

# Provides the `mymath` system library the `syslibdep` package links; the
# package's targets are generated in its own repository, so it must be public.
cc_library(
    name = "mymath_impl",
    srcs = ["mymath.c"],
    visibility = ["//visibility:public"],
)

# Provides the `optmath` system library the `optdep` package links when the
# `optmath` system integration is enabled.
cc_library(
    name = "optmath_impl",
    srcs = ["optmath.c"],
    visibility = ["//visibility:public"],
)

# Provide the system libraries the `cfgdep` package links under each cell of
# its `configure` matrix: `dbgonly` under the fallback `dbg` cell, `relonly`
# under the `rel` cell.
cc_library(
    name = "dbgonly_impl",
    srcs = ["dbgonly.c"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "relonly_impl",
    srcs = ["relonly.c"],
    visibility = ["//visibility:public"],
)

# The configuration matrix pushes `cfgdep`'s per-cell system library into a
# `select` overlay on its extracted module graph.
diff_test(
    name = "cfgdep_manifest_test",
    file1 = "cfgdep_manifest.expected.json",
    file2 = zig_package_file("cfgdep", "module_manifest.json"),
)
