load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_zig//zig:defs.bzl", "zig_binary")
load("@zig_deps//:defs.bzl", "zig_package_file", "zig_package_target")

# The binary imports each package's generated `zig_library` directly. `top`
# pulls its diamond (`left`/`right`/`bottom`/`base`) transitively. Of the
# copies of `lib`, v1 and its same-version fork are selected by dependency
# name, the fork remapped to `libfork`, and v2 by version, remapped to `lib2`.
libfork = zig_package_target("libfork")

lib2 = zig_package_target(
    "lib",
    version = "2.0.0",
)

zig_binary(
    name = "binary",
    import_names = {
        libfork: "libfork",
        lib2: "lib2",
    },
    main = "main.zig",
    deps = [
        zig_package_target("bottom"),
        zig_package_target("leaf"),
        zig_package_target("lib"),
        zig_package_target("top"),
        libfork,
        lib2,
    ],
)

# The extracted module graph of the multi-module fixture: two registered
# modules plus an anonymous one under a synthesized stable name.
diff_test(
    name = "multi_manifest_test",
    file1 = "multi_manifest.expected.json",
    file2 = zig_package_file("multi", "module_manifest.json"),
)
