load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_library")

# A manual import of the fetched package: the `@leaf` repository exposes the
# package's verified and extracted files, target definitions live here.
zig_library(
    name = "leaf",
    import_name = "leaf",
    main = "@leaf//:src/leaf.zig",
)

zig_binary(
    name = "binary",
    main = "main.zig",
    deps = [":leaf"],
)
