load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_library")
load("@zig_deps//:defs.bzl", "zig_package_deps", "zig_package_file")

# Manual imports of the fetched packages: one `zig_library` per package in the
# resolved graph, with `deps` derived from the exposed dependency edges (a
# dependency's target here is named after the name it is imported under).
[
    zig_library(
        name = pkg,
        import_name = pkg,
        main = zig_package_file(
            pkg,
            "src/" + pkg + ".zig",
            version = "0.0.0",
        ),
        deps = [":" + dep for dep in zig_package_deps(
            pkg,
            version = "0.0.0",
        )],
    )
    for pkg in [
        "leaf",
        "base",
        "bottom",
        "left",
        "right",
        "top",
    ]
]

# Several copies of the package `lib` coexist: v1 and a fork sharing its name
# and version, addressed by the manifest's dependency names, and v2, addressed
# by version.
zig_library(
    name = "libv1",
    import_name = "lib",
    main = zig_package_file("lib", "src/lib.zig"),
)

zig_library(
    name = "libfork",
    import_name = "libfork",
    main = zig_package_file("libfork", "src/lib.zig"),
)

zig_library(
    name = "libv2",
    import_name = "lib",
    main = zig_package_file(
        "lib",
        "src/lib.zig",
        version = "2.0.0",
    ),
)

zig_binary(
    name = "binary",
    import_names = {":libv2": "lib2"},
    main = "main.zig",
    deps = [
        ":bottom",
        ":leaf",
        ":libfork",
        ":libv1",
        ":libv2",
        ":top",
    ],
)

# The extracted module graph of the multi-module fixture: two registered
# modules plus an anonymous one under a synthesized stable name.
diff_test(
    name = "multi_manifest_test",
    file1 = "multi_manifest.expected.json",
    file2 = zig_package_file("multi", "module_manifest.json"),
)
