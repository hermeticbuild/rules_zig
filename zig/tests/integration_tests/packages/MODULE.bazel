module(name = "packages")

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_zig", version = "0.0.0")
bazel_dep(name = "child_module", version = "0.0.0")

local_path_override(
    module_name = "rules_zig",
    path = "../../../..",
)

local_path_override(
    module_name = "child_module",
    path = "child",
)

zig = use_extension("@rules_zig//zig:extensions.bzl", "zig")
zig.toolchain(zig_version = "0.17.0")
use_repo(zig, "zig_toolchains")

bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4", dev_dependency = True)

buildbuddy = use_extension(
    "@toolchains_buildbuddy//:extensions.bzl",
    "buildbuddy",
    dev_dependency = True,
)
use_repo(buildbuddy, "buildbuddy_toolchain")

zig_packages = use_extension("@rules_zig//zig:packages.bzl", "zig_packages")
zig_packages.from_file(build_zig_zon = "//:build.zig.zon")
zig_packages.from_file(build_zig_zon = "//path_deps/greeter:build.zig.zon")
zig_packages.from_file(build_zig_zon = "//path_deps/message:build.zig.zon")
zig_packages.system_library(
    name = "mymath",
    lib = "//:mymath_impl",
)
zig_packages.system_integration(name = "optmath")
zig_packages.system_library(
    name = "optmath",
    lib = "//:optmath_impl",
)
zig_packages.system_library(
    name = "dbgonly",
    lib = "//:dbgonly_impl",
)
zig_packages.system_library(
    name = "relonly",
    lib = "//:relonly_impl",
)
zig_packages.system_library(
    name = "boxlib",
    lib = "//:boxlib_impl",
)
zig_packages.system_library(
    name = "posixonly",
    lib = "//:posixonly_impl",
)
zig_packages.system_library(
    name = "winonly",
    lib = "//:winonly_impl",
)
zig_packages.system_library(
    name = "maconly",
    lib = "//:maconly_impl",
)
zig_packages.patch(
    name = "patchdep",
    patches = ["//:patches/patchdep_build_zig.patch"],
)
zig_packages.config(
    name = "dbg",
    optimize = "debug",
)
zig_packages.config(
    name = "rel",
    optimize = "release_fast",
)
zig_packages.configure(
    configs = [
        "dbg",
        "rel",
    ],
    fallback = "dbg",
    package = "cfgdep",
)
zig_packages.config(
    name = "linux",
    target = "x86_64-linux-gnu",
)
zig_packages.config(
    name = "windows",
    select_on = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    target = "x86_64-windows-gnu",
)

# `@platforms//cpu:arm64` and `@platforms//os:macos` are aliases; the
# `config_setting_group` keys on the underlying constraint values.
zig_packages.config(
    name = "macos",
    select_on = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
    target = "aarch64-macos",
)
zig_packages.configure(
    configs = [
        "linux",
        "macos",
        "windows",
    ],
    fallback = "linux",
    package = "tgtdep",
)
use_repo(zig_packages, "zig_deps")
