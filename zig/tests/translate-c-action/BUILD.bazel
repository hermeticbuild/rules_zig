load("@rules_cc//cc:defs.bzl", "cc_library")
load("//zig:defs.bzl", "zig_binary", "zig_c_library", "zig_library", "zig_static_library")
load("//zig/translate-c:toolchain.bzl", "translate_c_toolchain")
load(":fake_translate_c.bzl", "fake_translate_c")

cc_library(
    name = "c",
    hdrs = ["data.h"],
)

zig_c_library(
    name = "c_module",
    cdeps = [":c"],
    visibility = ["//zig/tests:__pkg__"],
)

zig_binary(
    name = "automatic_bindings",
    main = "bindings.zig",
    visibility = ["//zig/tests:__pkg__"],
    deps = [":c"],
)

zig_library(
    name = "explicit_module",
    import_name = "bindings",
    import_names = {":c_module": "c"},
    main = "bindings.zig",
    deps = [":c_module"],
)

zig_binary(
    name = "explicit_bindings",
    visibility = ["//zig/tests:__pkg__"],
    deps = [":explicit_module"],
)

cc_library(
    name = "native_library",
    srcs = ["native.c"],
    hdrs = ["data.h"],
)

cc_library(
    name = "native_flags",
    hdrs = ["data.h"],
    linkopts = ["-lm"],
)

cc_library(
    name = "native_inputs",
    hdrs = ["data.h"],
    additional_linker_inputs = ["data.h"],
)

[
    zig_binary(
        name = dependency + "_binary",
        main = "bindings.zig",
        visibility = ["//zig/tests:__pkg__"],
        deps = [":" + dependency],
    )
    for dependency in [
        "native_library",
        "native_flags",
        "native_inputs",
    ]
]

zig_static_library(
    name = "native_archive",
    main = "native.zig",
    deps = ["native_library"],
)

zig_binary(
    name = "native_archive_binary",
    main = "native_archive_main.zig",
    visibility = ["//zig/tests:__pkg__"],
    deps = ["native_archive"],
)

zig_c_library(
    name = "c_module_copts",
    cdeps = [":c"],
    copts = [
        "-DCOPTS_DEFINE=1",
        "-include",
        "$(execpath copts_include.h)",
    ],
    data = ["copts_include.h"],
    visibility = ["//zig/tests:__pkg__"],
)

fake_translate_c(
    name = "fake_translate_c",
)

translate_c_toolchain(
    name = "fake_translate_c_toolchain_impl",
    translate_c = ":fake_translate_c",
)

toolchain(
    name = "fake_translate_c_toolchain",
    target_settings = ["//zig/config/use_standalone_translate_c:enabled"],
    toolchain = ":fake_translate_c_toolchain_impl",
    toolchain_type = "//zig/translate-c:toolchain_type",
)
