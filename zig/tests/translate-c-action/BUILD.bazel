load("@rules_cc//cc:defs.bzl", "cc_library")
load("//zig:defs.bzl", "zig_c_library")
load("//zig:toolchain.bzl", "zig_target_toolchain")
load("//zig/translate-c:toolchain.bzl", "translate_c_toolchain")
load(":fake_translate_c.bzl", "fake_translate_c")

cc_library(
    name = "c",
    hdrs = ["data.h"],
)

zig_c_library(
    name = "c_module",
    cdeps = [":c"],
    visibility = ["//zig/tests:__pkg__"],
)

zig_c_library(
    name = "c_module_copts",
    cdeps = [":c"],
    copts = [
        "-DCOPTS_DEFINE=1",
        "-include",
        "$(execpath copts_include.h)",
    ],
    data = ["copts_include.h"],
    visibility = ["//zig/tests:__pkg__"],
)

# Analysis-only target that can be configured without a cross C compiler.
zig_c_library(
    name = "c_module_cross",
    cdeps = [],
    visibility = ["//zig/tests:__pkg__"],
)

zig_c_library(
    name = "c_module_sdk",
    cdeps = [],
    copts = [
        "-isysroot/older-sdk",
        "-isysroot",
        "/selected-sdk",
        "--sysroot=/link-sdk",
        "-iframework",
        "/explicit-frameworks",
    ],
    visibility = ["//zig/tests:__pkg__"],
)

zig_c_library(
    name = "c_module_no_standard_includes",
    cdeps = [],
    copts = [
        "-isysroot",
        "/selected-sdk",
        "--no-standard-includes",
        "-iframework",
        "/explicit-frameworks",
    ],
    visibility = ["//zig/tests:__pkg__"],
)

constraint_value(
    name = "zig-only-os",
    constraint_setting = "@platforms//os",
)

platform(
    name = "zig-only-macos",
    constraint_values = [
        ":zig-only-os",
        "@platforms//cpu:aarch64",
    ],
)

zig_target_toolchain(
    name = "zig_only_target",
    target = "aarch64-macos-none",
)

toolchain(
    name = "zig_only_target_toolchain",
    target_compatible_with = [":zig-only-os"],
    toolchain = ":zig_only_target",
    toolchain_type = "//zig/target:toolchain_type",
)

fake_translate_c(
    name = "fake_translate_c",
)

translate_c_toolchain(
    name = "fake_translate_c_toolchain_impl",
    translate_c = ":fake_translate_c",
)

toolchain(
    name = "fake_translate_c_toolchain",
    target_settings = ["//zig/config/use_standalone_translate_c:enabled"],
    toolchain = ":fake_translate_c_toolchain_impl",
    toolchain_type = "//zig/translate-c:toolchain_type",
)
