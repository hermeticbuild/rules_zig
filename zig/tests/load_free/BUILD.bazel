load("@bazel_skylib//rules:diff_test.bzl", "diff_test")

genquery(
    name = "toolchains_buildfiles",
    expression = "buildfiles(set(//zig/toolchains:zig_toolchain_type //zig/platforms/abi:abi))",
    scope = [
        "//zig/platforms/abi",
        "//zig/toolchains:zig_toolchain_type",
    ],
)

diff_test(
    name = "toolchains_load_free_test",
    size = "small",
    file1 = ":toolchains_buildfiles",
    file2 = "toolchains_buildfiles.golden",
)
