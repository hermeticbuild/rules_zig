load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")
load("//zig:defs.bzl", "zig_binary")

package(default_visibility = ["//zig/tests:__pkg__"])

_LINUX_AMD64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

cc_library(
    name = "registration",
    srcs = ["registration.c"],
    target_compatible_with = _LINUX_AMD64,
    alwayslink = True,
)

cc_library(
    name = "state",
    srcs = ["state.c"],
)

cc_import(
    name = "archive_only",
    static_library = ":libstate.a",
    tags = ["manual"],
    target_compatible_with = _LINUX_AMD64,
    alwayslink = True,
)

zig_binary(
    name = "binary",
    main = "main.zig",
    target_compatible_with = _LINUX_AMD64,
    deps = [
        ":registration",
        ":state",
        "//zig/lib:libc",
    ],
)

zig_binary(
    name = "archive_only_binary",
    main = "main.zig",
    tags = ["manual"],
    target_compatible_with = _LINUX_AMD64,
    deps = [":archive_only"],
)
