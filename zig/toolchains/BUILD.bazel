toolchain_type(
    name = "zig_toolchain_type",
    visibility = ["//visibility:public"],
)

toolchain_type(
    name = "target_toolchain_type",
    visibility = ["//visibility:public"],
)

toolchain_type(
    name = "zls_toolchain_type",
    visibility = ["//visibility:public"],
)

# ----------------------------------------------------------
# Default target toolchain definitions

# TODO[AH] Use a generated, version specific set of platforms.

toolchain(
    name = "x86_32-linux_toolchain",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_32",
    ],
    # default to gnu
    toolchain = "//zig/target:x86_32-linux-gnu",
    toolchain_type = ":target_toolchain_type",
)

toolchain(
    name = "x86_32-linux-none_toolchain",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_32",
