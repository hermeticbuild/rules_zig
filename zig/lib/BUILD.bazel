"""Helper targets to enable libc or libc++ linking.

The Zig compiler ships with various versions of libc and libc++. However, it
does not link against these libraries by default, and accordingly does not
expose standard library headers for C imports by default. To enable the import
of C standard library headers the compiler must be instructed to link against
libc or libc++ as appropriate.

The targets provided in this package can be used to accomplish this. Simply add
them to the `deps` attribute of your Zig target to enable libc or libc++
for Zig compilation and forward the requirement to the final link. When using
`cc_common.link`, choose a C/C++ toolchain that supplies the requested runtime.

For a Zig-owned link of objects compiled with a separate C++ toolchain, depend
on `:static_cpp_runtime` to pass that toolchain's C++ runtime archives to Zig.
Use it in place of `:libc++`, which enables Zig's bundled C++ runtime.
Select this dependency for Zig-owned links only. For `cc_common.link`, the C++
toolchain already supplies its own runtime.

```
zig_binary(
    name = "binary",
    main = "main.zig",
    deps = ["@rules_zig//zig/lib:libc"],
)
```

The Zig compiler includes a header file `zig.h` that is exposed by the
`:zig_header` target in this package and can be used as a regular `cc_*`
target dependency.
"""

load("//zig/private:cc_linkopts.bzl", "cc_linkopts")
load("//zig/private:cc_toolchain_runtime.bzl", "cc_toolchain_runtime")
load("//zig/private:zig_toolchain_header.bzl", "zig_toolchain_header")

zig_toolchain_header(
    name = "zig_header",
    visibility = ["//visibility:public"],
)

cc_linkopts(
    name = "libc",
    linkopts = ["-lc"],
    visibility = ["//visibility:public"],
)

cc_linkopts(
    name = "libc++",
    linkopts = ["-lc++"],
    visibility = ["//visibility:public"],
)

cc_toolchain_runtime(
    name = "static_cpp_runtime",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# Execute `bazel run //util:update_filegroups` to update this target.
filegroup(
    name = "all_files",
    srcs = [":BUILD.bazel"],
    visibility = ["//zig:__pkg__"],
)
